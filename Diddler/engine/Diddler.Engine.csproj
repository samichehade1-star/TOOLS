<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- FiddlerCore's static CONFIG initializer touches System.Windows.Forms
         (it was built for the WinForms-based Fiddler classic app) — without
         this it throws in CaptureEngine.Start() even though nothing here
         ever shows a WinForms window. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DiddlerEngine</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Diddler Engine</AssemblyTitle>
    <Product>Diddler Engine</Product>
    <Version>2.0.0</Version>
    <ApplicationIcon>diddler.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FiddlerCore" Version="4.6.2" />
  </ItemGroup>
</Project>
