{
  "name": "fmp-su-mod-manager",
  "version": "1.1.1",
  "description": "FMP Mod Manager — a mod manager for Dead by Daylight",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "desgubernamentalizar",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "7zip-bin": "^5.1.1",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.2.0",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "yauzl": "^3.1.3",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.desgubernamentalizar.fmpsu",
    "productName": "FMP Mod Manager",
    "publish": {
      "provider": "github",
      "owner": "samichehade1-star",
      "repo": "fmp-mod-manager"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "files": [
      "**/*",
      "!pakchunks.txt"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ]
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
