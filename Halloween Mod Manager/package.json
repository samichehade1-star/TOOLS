{
  "name": "halloween-mod-manager",
  "productName": "Halloween Mod Manager",
  "version": "1.0.0",
  "description": "Halloween Mod Manager â€” mod manager for Halloween (Ravage)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Sami Chehade",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.samichehade.halloweenmodmanager",
    "productName": "Halloween Mod Manager",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "samichehade1-star",
      "repo": "halloween-mod-manager"
    }
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.8.9",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "yauzl": "^3.4.0"
  }
}